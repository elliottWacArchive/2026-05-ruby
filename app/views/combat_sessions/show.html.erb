<div class="max-w-xl mx-auto">
  <h1 class="text-3xl text-red-400 font-bold mb-6 text-center">⚔ Combat</h1>

  <div class="flex items-center justify-around mb-8">
    <div class="text-center">
      <% if current_character.avatar.attached? %>
        <%= image_tag current_character.avatar, class: "w-20 h-20 rounded-full object-cover border-2 border-amber-600 mx-auto mb-2" %>
      <% else %>
        <div class="w-20 h-20 rounded-full bg-stone-700 flex items-center justify-center text-4xl mx-auto mb-2">🧙</div>
      <% end %>
      <div class="font-bold text-amber-200"><%= current_character.name %></div>
      <div class="text-sm <%= @combat.character_hp > 0 ? 'text-green-400' : 'text-red-400' %>">
        <%= @combat.character_hp %> PV
      </div>
    </div>

    <div class="text-4xl text-stone-500">VS</div>

    <div class="text-center">
      <% if @npc.avatar.attached? %>
        <%= image_tag @npc.avatar, class: "w-20 h-20 rounded-full object-cover border-2 border-red-700 mx-auto mb-2" %>
      <% else %>
        <div class="w-20 h-20 rounded-full bg-stone-700 flex items-center justify-center text-4xl mx-auto mb-2">👹</div>
      <% end %>
      <div class="font-bold text-red-200"><%= @npc.name %></div>
      <div class="text-sm <%= @combat.npc_hp > 0 ? 'text-green-400' : 'text-red-400' %>">
        <%= @combat.npc_hp %> PV
      </div>
    </div>
  </div>

  <% if @combat.ongoing? %>
    <div class="text-center mb-6">
      <%= button_to "⚔ Attaquer", attack_combat_session_path(@combat),
          method: :post,
          class: "bg-red-700 hover:bg-red-600 text-white font-bold px-10 py-4 rounded-lg text-xl" %>
    </div>
  <% elsif @combat.won? %>
    <div class="bg-green-900 border border-green-700 rounded p-4 text-center text-green-300 font-bold text-xl mb-4">
      Victoire !
    </div>
  <% elsif @combat.lost? %>
    <div class="bg-red-900 border border-red-700 rounded p-4 text-center text-red-300 font-bold text-xl mb-4">
      Défaite...
    </div>
    <%= link_to "Retour aux quêtes", quests_path, class: "block text-center text-stone-400 hover:text-stone-200 mt-2" %>
  <% end %>

  <% if @combat.log_entries.any? %>
    <div class="bg-stone-900 rounded p-4">
      <h3 class="text-stone-400 text-sm mb-3">Journal du combat</h3>
      <div class="space-y-1 text-sm">
        <% @combat.log_entries.last(10).each do |entry| %>
          <div class="<%= entry['turn'] == 'player' ? 'text-amber-300' : 'text-red-300' %>">
            <% if entry["turn"] == "player" %>
              Tu infligeas <%= entry["damage"] %> dégâts · <%= @npc.name %> : <%= entry["remaining"] %> PV
            <% else %>
              <%= @npc.name %> infligea <%= entry["damage"] %> dégâts · toi : <%= entry["remaining"] %> PV
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
