<!DOCTYPE html>
<html lang="fr">
  <head>
    <title>Admin — Medieval RPG</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-950 text-amber-100 min-h-screen font-serif">

    <nav class="bg-red-950 border-b border-red-800 px-6 py-3 flex items-center justify-between">
      <a href="<%= admin_root_path %>" class="text-red-300 text-xl font-bold tracking-widest">⚙ Admin RPG</a>
      <div class="flex items-center gap-6 text-sm">
        <%= link_to "Quêtes", admin_quests_path, class: "text-red-200 hover:text-red-100" %>
        <%= link_to "Objets", admin_items_path, class: "text-red-200 hover:text-red-100" %>
        <%= link_to "Joueurs", admin_characters_path, class: "text-red-200 hover:text-red-100" %>
        <%= link_to "← Site", root_path, class: "text-stone-400 hover:text-stone-200" %>
        <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-stone-400" %>
      </div>
    </nav>

    <% if notice %>
      <div class="bg-green-900 border border-green-700 text-green-200 px-6 py-3 text-sm"><%= notice %></div>
    <% end %>
    <% if alert %>
      <div class="bg-red-900 border border-red-700 text-red-200 px-6 py-3 text-sm"><%= alert %></div>
    <% end %>

    <main class="container mx-auto px-6 py-8">
      <%= yield %>
    </main>

  </body>
</html>
