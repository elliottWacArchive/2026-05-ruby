<!DOCTYPE html>
<html lang="fr">
  <head>
    <title><%= content_for(:title) || "Medieval RPG" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <script src="https://cdn.tailwindcss.com"></script>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-stone-950 text-amber-100 min-h-screen font-serif">

    <nav class="bg-stone-900 border-b border-amber-800 px-6 py-3 flex items-center justify-between">
      <a href="<%= root_path %>" class="text-amber-400 text-xl font-bold tracking-widest">⚔ Medieval RPG</a>

      <div class="flex items-center gap-6 text-sm">
        <% if user_signed_in? %>
          <% if current_character %>
            <span class="text-amber-300">
              <%= current_character.name %>
              <span class="text-stone-400 text-xs ml-1">Niv. <%= current_character.level %></span>
            </span>
            <%= link_to "Personnage", character_path(current_character), class: "text-amber-200 hover:text-amber-400" %>
            <%= link_to "Inventaire", character_inventories_path(current_character), class: "text-amber-200 hover:text-amber-400" %>
            <%= link_to "Quêtes", quests_path, class: "text-amber-200 hover:text-amber-400" %>
            <%= link_to "Marché", auction_listings_path, class: "text-amber-200 hover:text-amber-400" %>
          <% end %>
          <% if current_user.game_master? %>
            <%= link_to "⚙ Admin", admin_root_path, class: "text-red-400 hover:text-red-300" %>
          <% end %>
          <%= link_to "Déconnexion", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-stone-400 hover:text-stone-200" %>
        <% else %>
          <%= link_to "Connexion", new_user_session_path, class: "text-amber-200 hover:text-amber-400" %>
          <%= link_to "Inscription", new_user_registration_path, class: "text-amber-200 hover:text-amber-400" %>
        <% end %>
      </div>
    </nav>

    <% if notice %>
      <div class="bg-green-900 border border-green-700 text-green-200 px-6 py-3 text-sm" data-controller="flash">
        <%= notice %>
      </div>
    <% end %>
    <% if alert %>
      <div class="bg-red-900 border border-red-700 text-red-200 px-6 py-3 text-sm" data-controller="flash">
        <%= alert %>
      </div>
    <% end %>

    <main class="container mx-auto px-6 py-8">
      <%= yield %>
    </main>

  </body>
</html>
