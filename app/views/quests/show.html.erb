<div class="max-w-2xl mx-auto">
  <h1 class="text-3xl text-amber-400 font-bold mb-2"><%= @quest.name %></h1>
  <p class="text-stone-400 mb-6"><%= @quest.description %></p>

  <% if @progress.nil? %>
    <p class="text-stone-500">Tu n'as pas encore commencé cette quête.</p>
    <%= button_to "Commencer", quest_quest_progresses_path(@quest), method: :post,
        class: "bg-amber-700 hover:bg-amber-600 text-white px-6 py-3 rounded mt-4" %>

  <% elsif @progress.completed? %>
    <div class="bg-green-900 border border-green-700 rounded-lg p-6 text-center">
      <div class="text-4xl mb-2">🏆</div>
      <p class="text-green-300 font-bold text-xl">Quête terminée !</p>
    </div>

  <% else %>
    <% step = @progress.current_step %>
    <% reward_ids = session[:reward_items] %>

    <% if reward_ids.present? %>
      <%# sélection de la récompense %>
      <div class="bg-amber-900 border border-amber-700 rounded-lg p-6 mb-6">
        <h2 class="text-amber-300 font-bold text-xl mb-4">🎁 Choisis ta récompense</h2>
        <div class="grid grid-cols-3 gap-4">
          <% Item.where(id: reward_ids).each do |item| %>
            <%= form_with url: claim_reward_quest_path(@quest), method: :post do |f| %>
              <%= f.hidden_field :item_id, value: item.id %>
              <%= f.button type: "submit",
                  class: "w-full bg-stone-700 hover:bg-stone-600 border border-amber-700 text-amber-200 rounded p-4 text-sm text-left" do %>
                <div class="font-bold text-amber-200 mb-1"><%= item.name %></div>
                <div class="text-xs text-stone-400 mb-1"><%= item.slot_label %></div>
                <div class="text-xs text-stone-500">
                  HP: <%= item.hp_bonus >= 0 ? "+" : "" %><%= item.hp_bonus %> ·
                  Force: <%= item.strength_bonus >= 0 ? "+" : "" %><%= item.strength_bonus %>
                  <% if item.xp_multiplier != 1.0 %> · ×<%= item.xp_multiplier %> XP<% end %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="bg-stone-800 border border-stone-700 rounded-lg p-6 mb-6">
      <div class="text-stone-400 text-sm mb-2">Étape <%= @progress.current_step_index + 1 %> / <%= @quest.steps.count %></div>

      <% if step.nil? %>
        <p class="text-stone-500">Cette quête n'a plus d'étapes.</p>
      <% else %>
        <% riddle = step.riddle %>
        <% npc = step.npc %>

        <% if riddle %>
          <div class="mb-6">
            <h2 class="text-xl text-amber-200 font-bold mb-4">🔮 Énigme</h2>
            <p class="text-amber-100 text-lg mb-4"><%= riddle.question %></p>

            <%= form_with url: answer_riddle_quest_quest_progress_path(@quest, @progress), method: :post do |f| %>
              <div class="space-y-2 mb-4">
                <% riddle.answers.shuffle.each do |answer| %>
                  <label class="flex items-center gap-3 bg-stone-700 hover:bg-stone-600 rounded p-3 cursor-pointer">
                    <%= radio_button_tag :answer_id, answer.id, false, class: "accent-amber-500" %>
                    <span><%= answer.text %></span>
                  </label>
                <% end %>
              </div>
              <%= f.submit "Répondre", class: "bg-amber-700 hover:bg-amber-600 text-white px-6 py-2 rounded" %>
            <% end %>
          </div>
        <% end %>

        <% if npc %>
          <div class="border-t border-stone-700 pt-6">
            <h2 class="text-xl text-red-300 font-bold mb-3">⚔ Combat alternatif</h2>
            <div class="flex items-center gap-4 mb-4">
              <% if npc.avatar.attached? %>
                <%= image_tag npc.avatar, class: "w-16 h-16 rounded-full object-cover border border-red-800" %>
              <% else %>
                <div class="w-16 h-16 rounded-full bg-stone-700 flex items-center justify-center text-3xl">👹</div>
              <% end %>
              <div>
                <div class="font-bold text-red-200"><%= npc.name %></div>
                <div class="text-sm text-stone-400"><%= npc.hp %> PV · <%= npc.strength %> Force</div>
              </div>
            </div>

            <% existing_combat = current_character.combat_sessions.find_by(npc: npc, status: "ongoing") %>
            <% if existing_combat %>
              <%= link_to "▶ Reprendre le combat", combat_session_path(existing_combat),
                  class: "bg-red-800 hover:bg-red-700 text-white px-6 py-2 rounded" %>
            <% else %>
              <%= button_to "⚔ Combattre #{npc.name}", combat_sessions_path(npc_id: npc.id),
                  method: :post,
                  class: "bg-red-800 hover:bg-red-700 text-white px-6 py-2 rounded" %>
            <% end %>

            <%# chat PNJ — les messages du mj arrivent en temps réel %>
            <div class="mt-6">
              <%= turbo_stream_from "npc_chat_#{npc.id}_char_#{current_character.id}" %>
              <h3 class="text-stone-400 text-sm mb-2">Messages de <%= npc.name %></h3>
              <div id="npc_chat_<%= npc.id %>_char_<%= current_character.id %>"
                   class="bg-stone-900 rounded p-3 h-32 overflow-y-auto space-y-2 mb-2">
                <% Message.where(npc: npc, character: current_character).order(:created_at).each do |msg| %>
                  <%= render "messages/message", message: msg %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
