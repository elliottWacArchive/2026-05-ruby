<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl text-red-300 font-bold">Objets & équipements</h1>
  <%= link_to "＋ Nouvel objet", new_admin_item_path,
      class: "bg-red-800 hover:bg-red-700 text-white px-4 py-2 rounded text-sm" %>
</div>

<div class="space-y-2">
  <% @items.each do |item| %>
    <div class="bg-stone-800 border border-stone-700 rounded-lg p-4 flex items-center justify-between">
      <div class="flex items-center gap-4">
        <% if item.image.attached? %>
          <%= image_tag item.image, class: "w-10 h-10 rounded object-cover" %>
        <% else %>
          <div class="w-10 h-10 rounded bg-stone-700 flex items-center justify-center">
            <%= { "hat" => "🎩", "weapon" => "⚔️", "shield" => "🛡️" }[item.slot] %>
          </div>
        <% end %>
        <div>
          <div class="font-bold text-amber-200"><%= item.name %></div>
          <div class="text-xs text-stone-400">
            <%= item.slot_label %> ·
            HP: <%= item.hp_bonus > 0 ? "+" : "" %><%= item.hp_bonus %> ·
            Force: <%= item.strength_bonus > 0 ? "+" : "" %><%= item.strength_bonus %> ·
            XP ×<%= item.xp_multiplier %>
          </div>
        </div>
      </div>
      <div class="flex gap-3 text-sm">
        <%= link_to "Modifier", edit_admin_item_path(item), class: "text-amber-400 hover:text-amber-300" %>
        <%= button_to "Supprimer", admin_item_path(item), method: :delete,
            data: { turbo_confirm: "Supprimer cet objet ?" },
            class: "text-stone-400 hover:text-red-300" %>
      </div>
    </div>
  <% end %>
</div>
