<%= form_with model: [:admin, item], class: "space-y-5", multipart: true do |f| %>
  <div>
    <%= f.label :name, "Nom", class: "block text-amber-300 mb-1 text-sm" %>
    <%= f.text_field :name, class: "w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2" %>
  </div>

  <div>
    <%= f.label :slot, "Slot", class: "block text-amber-300 mb-1 text-sm" %>
    <%= f.select :slot, [["Chapeau", "hat"], ["Arme", "weapon"], ["Bouclier", "shield"]],
        {}, class: "bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2 w-48" %>
  </div>

  <div class="grid grid-cols-3 gap-4">
    <div>
      <%= f.label :hp_bonus, "Bonus PV", class: "block text-amber-300 mb-1 text-sm" %>
      <%= f.number_field :hp_bonus, class: "w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2" %>
    </div>
    <div>
      <%= f.label :strength_bonus, "Bonus Force", class: "block text-amber-300 mb-1 text-sm" %>
      <%= f.number_field :strength_bonus, class: "w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2" %>
    </div>
    <div>
      <%= f.label :xp_multiplier, "Mult. XP", class: "block text-amber-300 mb-1 text-sm" %>
      <%= f.number_field :xp_multiplier, step: 0.1, min: 0.1, class: "w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2" %>
    </div>
  </div>

  <div>
    <%= f.label :image, "Image", class: "block text-amber-300 mb-1 text-sm" %>
    <%= f.file_field :image, accept: "image/*", class: "text-sm text-stone-400" %>
  </div>

  <%= f.submit "Enregistrer", class: "bg-red-800 hover:bg-red-700 text-white px-6 py-2 rounded cursor-pointer" %>
<% end %>
