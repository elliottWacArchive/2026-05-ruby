<div class="flex items-center justify-between mb-6">
  <h1 class="text-2xl text-red-300 font-bold">Quêtes</h1>
  <%= link_to "＋ Nouvelle quête", new_admin_quest_path,
      class: "bg-red-800 hover:bg-red-700 text-white px-4 py-2 rounded text-sm" %>
</div>

<% if @quests.empty? %>
  <p class="text-stone-500">Aucune quête créée.</p>
<% else %>
  <div class="space-y-3">
    <% @quests.each do |quest| %>
      <div class="bg-stone-800 border border-stone-700 rounded-lg p-4 flex items-center justify-between">
        <div>
          <div class="font-bold text-amber-200"><%= quest.name %></div>
          <div class="text-xs text-stone-400"><%= quest.steps.count %> étape(s) · <%= quest.completion_xp %> XP</div>
        </div>
        <div class="flex gap-3 text-sm">
          <%= link_to "Voir", admin_quest_path(quest), class: "text-red-300 hover:text-red-200" %>
          <%= link_to "Modifier", edit_admin_quest_path(quest), class: "text-amber-400 hover:text-amber-300" %>
          <%= button_to "Supprimer", admin_quest_path(quest), method: :delete,
              data: { turbo_confirm: "Supprimer cette quête ?" },
              class: "text-stone-400 hover:text-red-300" %>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
