<div class="max-w-md mx-auto">
  <h1 class="text-2xl text-amber-400 font-bold mb-6">Mettre un objet en vente</h1>

  <% if @inventory_items.empty? %>
    <p class="text-stone-400">Tu n'as pas d'objets non équipés disponibles.</p>
    <%= link_to "← Retour", auction_listings_path, class: "text-amber-600 hover:text-amber-400 mt-4 inline-block" %>
  <% else %>
    <%= form_with url: auction_listings_path, method: :post, class: "space-y-5" do %>
      <div>
        <label class="block text-amber-300 mb-1 text-sm">Objet à vendre</label>
        <select name="inventory_id" class="w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2">
          <% @inventory_items.each do |inv| %>
            <option value="<%= inv.id %>"><%= inv.item.name %> (<%= inv.item.slot_label %>)</option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-amber-300 mb-1 text-sm">Prix (or)</label>
        <%= number_field_tag :price, 10, min: 1, class: "w-full bg-stone-800 border border-stone-600 text-amber-100 rounded px-4 py-2" %>
      </div>
      <button class="w-full bg-amber-700 hover:bg-amber-600 text-white font-bold py-3 rounded">Mettre en vente</button>
    <% end %>
  <% end %>
</div>
